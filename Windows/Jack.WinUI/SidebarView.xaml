<UserControl
    x:Class="Jack.WinUI.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="12,4,12,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button x:Name="NewAgentButton" Click="NewAgentButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                Style="{ThemeResource AccentButtonStyle}" Height="40" Padding="12,0" CornerRadius="8"
                ToolTipService.ToolTip="Nuevo agente (Ctrl+N)" AutomationProperties.Name="Nuevo agente">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE710;" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Nuevo agente" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Ctrl N" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
            </Grid>
        </Button>

        <Border Grid.Row="1" CornerRadius="8" Padding="12,0" Height="36" BorderThickness="0,0,0,1"
                Background="{ThemeResource JackPanelBrush}" BorderBrush="{ThemeResource JackStrongLineBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE721;" FontSize="13" Foreground="{ThemeResource JackMutedBrush}" />
                <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Buscar" FontSize="14" MinHeight="0"
                         Background="Transparent" BorderThickness="0" Padding="0,6,0,6" VerticalAlignment="Center"
                         TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Buscar agentes">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                </TextBox>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ListHost" Spacing="2" Padding="0,4,0,0" />
        </ScrollViewer>

        <Button Grid.Row="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent"
                BorderThickness="0" Padding="10,8" CornerRadius="8"
                ToolTipService.ToolTip="Ajustes: llegarán más adelante" AutomationProperties.Name="Ajustes">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
                <TextBlock Text="Ajustes" FontSize="14" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
