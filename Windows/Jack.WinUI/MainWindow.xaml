<Window
    x:Class="Jack.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Jack.WinUI"
    Title="Jack">
    <Grid x:Name="Root" Background="{ThemeResource JackCanvasBrush}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewAgentShortcut_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra de título arrastrable: logo + nombre. -->
        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Padding="14,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/jack.png" Width="18" Height="18" />
                <TextBlock Text="Jack" FontSize="12" Foreground="{ThemeResource JackMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ui:SidebarView x:Name="Sidebar" Grid.Row="1" />

        <!-- Panel principal: cabecera, avisos y contenido. -->
        <Border Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource JackSurfaceBrush}" BorderBrush="{ThemeResource JackHairlineBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="HeaderBar" Grid.Row="0" Height="60" Padding="20,0,16,0" BorderThickness="0,0,0,1"
                      BorderBrush="{ThemeResource JackHairlineBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="ConversationTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="ConversationDescription" FontSize="12" Foreground="{ThemeResource JackMutedBrush}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="560" />
                            <TextBlock x:Name="ConversationState" FontSize="12" Foreground="{ThemeResource JackAccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="StopButton" Grid.Column="1" Content="Detener" Click="Stop_Click" Visibility="Collapsed"
                            VerticalAlignment="Center" Padding="16,6" CornerRadius="8" Background="Transparent"
                            BorderBrush="{ThemeResource JackStrongLineBrush}" />
                </Grid>

                <InfoBar x:Name="ErrorBar" Grid.Row="1" Severity="Error" IsOpen="False" IsClosable="True"
                         Margin="12,6,12,0" Closed="ErrorBar_Closed" />

                <Grid x:Name="EmptyState" Grid.Row="2">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420" Margin="24">
                        <Image Source="Assets/jack.png" Width="48" Height="48" Margin="0,0,0,6" />
                        <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="EmptyBody" TextAlignment="Center" Style="{StaticResource JackSecondaryText}" />
                        <Button x:Name="EmptyNewAgentButton" Click="NewAgent_Click" HorizontalAlignment="Center" Margin="0,10,0,0"
                                Style="{ThemeResource AccentButtonStyle}" Padding="18,8" CornerRadius="8" Content="Nuevo agente" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ConversationView" Grid.Row="2" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:TranscriptView x:Name="Transcript" Grid.Row="0" />

                    <!-- Pantalla de agente nuevo: elegir carpeta y escribir el primer mensaje, en el propio chat. -->
                    <ScrollViewer x:Name="NewChatPanel" Grid.Row="0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  Background="{ThemeResource JackSurfaceBrush}">
                        <StackPanel x:Name="NewChatBox" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Padding="0,24">
                            <Image Source="Assets/jack.png" Width="52" Height="52" HorizontalAlignment="Center" />
                            <TextBlock Text="¿En qué carpeta trabajamos?" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Elige el proyecto y escribe tu primer mensaje abajo." Style="{StaticResource JackSecondaryText}"
                                       HorizontalAlignment="Center" TextAlignment="Center" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="8" BorderThickness="1" Padding="12,0" MinHeight="40"
                                        Background="{ThemeResource JackPanelBrush}" BorderBrush="{ThemeResource JackStrongLineBrush}">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14" Foreground="{ThemeResource JackMutedBrush}" VerticalAlignment="Center" />
                                        <TextBox x:Name="NewFolder" Grid.Column="1" PlaceholderText="Ruta de la carpeta del proyecto"
                                                 Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="14"
                                                 TextChanged="NewFolder_TextChanged" AutomationProperties.Name="Carpeta del proyecto">
                                            <TextBox.Resources>
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                            </TextBox.Resources>
                                        </TextBox>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="1" Content="Examinar…" Click="NewBrowse_Click" Height="40" Padding="16,0" CornerRadius="8" />
                            </Grid>
                            <TextBlock x:Name="NewHint" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                            <StackPanel x:Name="NewRecentBox" Spacing="2">
                                <TextBlock Text="Recientes" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource JackMutedBrush}" Margin="4,6,0,2" />
                                <StackPanel x:Name="NewRecent" Spacing="1" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="ApprovalsHost" Grid.Row="1" Padding="24,8,24,0" Visibility="Collapsed">
                        <StackPanel x:Name="ApprovalsBox" HorizontalAlignment="Center" Spacing="8" />
                    </Grid>

                    <Grid x:Name="ComposerHost" Grid.Row="2" Padding="24,8,24,10">
                        <StackPanel x:Name="ComposerBox" HorizontalAlignment="Center" Spacing="6">
                            <StackPanel x:Name="QueueHost" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" />
                            <!-- Borde inferior de 2 px de acento: el Border exterior es el acento; el interior, la caja. -->
                            <Border CornerRadius="12" Background="{ThemeResource JackAccentBrush}" Padding="0,0,0,2">
                                <Border CornerRadius="12,12,10,10" BorderThickness="1" Padding="14,10,10,8"
                                        Background="{ThemeResource JackComposerBrush}" BorderBrush="{ThemeResource JackStrongLineBrush}">
                                    <StackPanel Spacing="6">
                                        <StackPanel x:Name="AttachmentsHost" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" />
                                        <TextBox x:Name="Composer" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="48" MaxHeight="200" FontSize="14"
                                                 Background="Transparent" BorderThickness="0" Padding="0,6"
                                                 PlaceholderText="Escribe un mensaje…"
                                                 AutomationProperties.Name="Mensaje"
                                                 PreviewKeyDown="Composer_KeyDown" TextChanged="Composer_TextChanged">
                                            <TextBox.Resources>
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                            </TextBox.Resources>
                                        </TextBox>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.Resources>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="MinHeight" Value="32" />
                                                    <Setter Property="CornerRadius" Value="16" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Padding" Value="14,0,0,0" />
                                                </Style>
                                            </Grid.Resources>
                                            <Button x:Name="AttachButton" Click="Attach_Click" Width="36" Height="36" Padding="0"
                                                    Background="Transparent" BorderThickness="0" CornerRadius="18"
                                                    ToolTipService.ToolTip="Adjuntar archivos" AutomationProperties.Name="Adjuntar archivos">
                                                <FontIcon Glyph="&#xE723;" FontSize="15" Foreground="{ThemeResource JackMutedBrush}" />
                                            </Button>
                                            <StackPanel x:Name="SettingsRow" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <ComboBox x:Name="ModelBox" MinWidth="120" AutomationProperties.Name="Modelo"
                                                          ToolTipService.ToolTip="Modelo" SelectionChanged="ModelBox_SelectionChanged" />
                                                <ComboBox x:Name="EffortBox" MinWidth="100" AutomationProperties.Name="Esfuerzo"
                                                          ToolTipService.ToolTip="Esfuerzo" SelectionChanged="EffortBox_SelectionChanged" />
                                                <ComboBox x:Name="ModeBox" MinWidth="120" AutomationProperties.Name="Modo de permisos"
                                                          ToolTipService.ToolTip="Modo de permisos" SelectionChanged="ModeBox_SelectionChanged" />
                                            </StackPanel>
                                            <Button x:Name="SendButton" Grid.Column="2" Click="Send_Click" Width="36" Height="36" Padding="0"
                                                    CornerRadius="18" Style="{ThemeResource AccentButtonStyle}"
                                                    ToolTipService.ToolTip="Enviar" AutomationProperties.Name="Enviar">
                                                <FontIcon x:Name="SendGlyph" Glyph="&#xE74A;" FontSize="14" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Border>
                            <TextBlock Text="Intro envía · Mayús+Intro nueva línea" FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource JackMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
