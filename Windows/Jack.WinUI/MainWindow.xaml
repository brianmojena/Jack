<Window
    x:Class="Jack.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Jack.WinUI"
    Title="Jack">
    <Grid x:Name="Root" Background="{ThemeResource JackCanvasBrush}" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewConversation_Accelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.Resources>
            <!-- Plantillas de los mensajes de la conversación -->
            <DataTemplate x:Key="UserTurn" x:DataType="local:Turn">
                <Border HorizontalAlignment="Right" MaxWidth="540" CornerRadius="16,16,4,16" Padding="14,10"
                        Background="{ThemeResource JackBubbleBrush}">
                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" LineHeight="20" IsTextSelectionEnabled="True" />
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="AgentTurn" x:DataType="local:Turn">
                <TextBlock local:Look.Rich="{x:Bind Text}" TextWrapping="Wrap" LineHeight="20" IsTextSelectionEnabled="True" />
            </DataTemplate>

            <DataTemplate x:Key="FileRowTemplate" x:DataType="local:FileRow">
                <Grid MinHeight="36" Padding="10,0" ColumnSpacing="10" CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="3" Margin="-10,0" CornerRadius="8" Background="{ThemeResource JackRowHoverBrush}"
                            Opacity="{x:Bind TintOpacity}" IsHitTestVisible="False" />
                    <local:Spinner Visibility="{x:Bind ShowRunning}" />
                    <FontIcon Glyph="&#xE73E;" FontSize="13" Visibility="{x:Bind ShowDone}"
                              Foreground="{ThemeResource JackSuccessBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource JackMono}"
                               Foreground="{ThemeResource JackTextBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{x:Bind ActionText}" Style="{StaticResource JackMono}"
                               VerticalAlignment="Center" Visibility="{x:Bind ShowDone}" />
                    <TextBlock Grid.Column="2" Text="{x:Bind ActionText}" Style="{StaticResource JackMono}"
                               VerticalAlignment="Center" Visibility="{x:Bind ShowRunning}"
                               Foreground="{ThemeResource JackAccentTextBrush}" />
                </Grid>
            </DataTemplate>

            <!-- Tarjeta plegable de herramientas: cabecera, nota y filas de archivos. -->
            <DataTemplate x:Key="ToolsTurn" x:DataType="local:Turn">
                <Border CornerRadius="12" Padding="6" BorderThickness="1"
                        Background="{ThemeResource JackCardBrush}" BorderBrush="{ThemeResource JackCardBorderBrush}">
                    <StackPanel>
                        <Button Click="ToolHeader_Click" Style="{StaticResource JackButton}" Height="40" Padding="10,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind Group.Title}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource JackSuccessBrush}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Group.Title}" />
                                    <TextBlock Text="{x:Bind Group.Summary}" Foreground="{ThemeResource JackMutedBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="11" Foreground="{ThemeResource JackMutedBrush}" />
                            </Grid>
                        </Button>
                        <StackPanel>
                            <TextBlock local:Look.Rich="{x:Bind Group.Note}" Visibility="{x:Bind Group.ShowNote}" TextWrapping="Wrap"
                                       Margin="10,4,10,8" FontSize="13" Foreground="{ThemeResource JackMutedBrush}" />
                            <StackPanel Visibility="{x:Bind Group.ShowFiles}">
                                <TextBlock Text="{x:Bind Group.FilesLabel}" FontSize="12" FontWeight="SemiBold" Margin="10,4,10,4"
                                           Foreground="{ThemeResource JackMutedBrush}" />
                                <ItemsControl ItemsSource="{x:Bind Group.Files}" ItemTemplate="{StaticResource FileRowTemplate}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <local:TurnSelector x:Key="TurnSelector" User="{StaticResource UserTurn}" Agent="{StaticResource AgentTurn}"
                                Tools="{StaticResource ToolsTurn}" />

            <Style x:Key="BareTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <!-- Por debajo de 760 px la barra lateral se oculta (como la maqueta). El último estado activo gana. -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarColumn.Width" Value="0" />
                        <Setter Target="Sidebar.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Barra de título: 40 px, logo 18×18, texto atenuado. -->
        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Padding="14,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="18" Height="18" CornerRadius="5" VerticalAlignment="Center"
                    Background="{StaticResource JackAccentBrush}">
                <TextBlock Text="J" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource JackAccentInkBrush}" />
            </Border>
            <TextBlock Grid.Column="1" Text="Jack" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource JackMutedBrush}" />
        </Grid>

        <!-- Barra lateral: sin panel, sobre el lienzo. -->
        <Grid x:Name="Sidebar" Grid.Row="1" Padding="12,4,12,12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button x:Name="NewConversationButton" Click="NewConversation_Click" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Style="{StaticResource JackAccentButton}" Height="40"
                    AutomationProperties.Name="Nuevo agente" ToolTipService.ToolTip="Nuevo agente (Ctrl+N)">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock Grid.Column="1" Text="Nuevo agente" FontWeight="SemiBold"
                               Foreground="{StaticResource JackAccentInkBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Ctrl N" FontSize="12" FontWeight="Normal"
                               Foreground="{StaticResource JackAccentInkBrush}" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Border Grid.Row="1" Height="36" CornerRadius="8" BorderThickness="0,0,0,1"
                    Background="{ThemeResource JackSearchBrush}" BorderBrush="{ThemeResource JackSearchLineBrush}">
                <Grid Padding="10,0,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource JackMutedBrush}" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Buscar" Style="{StaticResource BareTextBox}"
                             Padding="0,7,8,7" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Buscar">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="AgentList" Spacing="2" AutomationProperties.Name="Agentes" />
            </ScrollViewer>

            <!-- Todavía no existe la pantalla de ajustes: el botón queda visible sin acción. -->
            <Button Grid.Row="3" Style="{StaticResource JackButton}" HorizontalAlignment="Left" AutomationProperties.Name="Ajustes">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <TextBlock Text="Ajustes" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Panel principal -->
        <Border Grid.Row="1" Grid.Column="1" Margin="0,0,8,8" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource JackSurfaceBrush}" BorderBrush="{ThemeResource JackPanelBorderBrush}">
            <Grid>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                            MaxWidth="520" Margin="24">
                    <TextBlock Text="Tus agentes, en un solo lugar" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="Elige la carpeta de un proyecto y un proveedor (Codex, Claude Code u OpenCode). Cada agente trabaja en su propia conversación."
                               TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource JackMutedBrush}" />
                    <Button Click="NewConversation_Click" HorizontalAlignment="Center" Margin="0,8,0,0" Height="40" Padding="18,0"
                            Style="{StaticResource JackAccentButton}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Nuevo agente" FontWeight="SemiBold" Foreground="{StaticResource JackAccentInkBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Grid x:Name="ConversationView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Padding="20,0" ColumnSpacing="16" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource JackSeparatorBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ConversationTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource JackMutedBrush}" TextTrimming="CharacterEllipsis">
                                <Run x:Name="HeaderFolder" /><Run Text=" · " /><Run x:Name="HeaderProvider" /><Run Text=" · " /><Run x:Name="HeaderBusy" Foreground="{ThemeResource JackAccentTextBrush}" /><Run x:Name="HeaderIdle" Foreground="{ThemeResource JackAmberTextBrush}" />
                            </TextBlock>
                        </StackPanel>
                        <Button x:Name="StopButton" Grid.Column="1" Style="{StaticResource JackOutlineButton}" Content="Detener"
                                VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Detener" />
                    </Grid>

                    <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Transcript" ItemTemplateSelector="{StaticResource TurnSelector}"
                                      MaxWidth="760" HorizontalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="18" Margin="24,24,24,8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Padding="24,8,24,14">
                        <StackPanel MaxWidth="760" Spacing="6">
                            <Grid>
                                <Border CornerRadius="12" Background="{StaticResource JackAccentBrush}" />
                                <Border CornerRadius="12" Margin="0,0,0,2" BorderThickness="1,1,1,0" Padding="10,10,10,8"
                                        Background="{ThemeResource JackComposerBrush}" BorderBrush="{ThemeResource JackStrokeBrush}">
                                    <StackPanel Spacing="4">
                                        <TextBox x:Name="Composer" IsEnabled="False" AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="48" MaxHeight="160" Padding="6,4" PlaceholderText="Escribe un mensaje…"
                                                 Style="{StaticResource BareTextBox}" AutomationProperties.Name="Mensaje">
                                            <TextBox.Resources>
                                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                                <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#A3A9B5" />
                                                <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#A3A9B5" />
                                            </TextBox.Resources>
                                        </TextBox>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button IsEnabled="False" Width="36" Padding="0" Style="{StaticResource JackButton}"
                                                    AutomationProperties.Name="Adjuntar">
                                                <FontIcon Glyph="&#xE723;" FontSize="14" />
                                            </Button>
                                            <Button Grid.Column="1" Style="{StaticResource JackPill}" AutomationProperties.Name="Modelo">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock x:Name="ModelText" FontSize="13" VerticalAlignment="Center" />
                                                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                                </StackPanel>
                                                <Button.Flyout><MenuFlyout x:Name="ModelMenu" /></Button.Flyout>
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource JackPill}" AutomationProperties.Name="Esfuerzo">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock x:Name="EffortText" FontSize="13" VerticalAlignment="Center" />
                                                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                                </StackPanel>
                                                <Button.Flyout><MenuFlyout x:Name="EffortMenu" /></Button.Flyout>
                                            </Button>
                                            <Button Grid.Column="3" Style="{StaticResource JackPill}" AutomationProperties.Name="Permisos">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock x:Name="ModeText" FontSize="13" VerticalAlignment="Center" />
                                                    <FontIcon Glyph="&#xE70D;" FontSize="10" />
                                                </StackPanel>
                                                <Button.Flyout><MenuFlyout x:Name="ModeMenu" /></Button.Flyout>
                                            </Button>
                                            <Button x:Name="SendButton" Grid.Column="5" IsEnabled="False" Width="36" Height="36" Padding="0"
                                                    CornerRadius="18" Style="{StaticResource JackAccentButton}" AutomationProperties.Name="Enviar">
                                                <FontIcon x:Name="SendIcon" Glyph="&#xE724;" FontSize="14" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="ComposerHint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       FontSize="11" Foreground="{ThemeResource JackMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
